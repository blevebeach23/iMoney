# Local Supabase:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#
# Supabase Cloud:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Use the Supabase anon/publishable key only.
# Never put the service_role key in this file or in Vercel client env vars.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Production:
# NEXT_PUBLIC_SITE_URL=https://i-money-five.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only, required for Family invite emails through Supabase Auth Admin.
# Configure it only in local server/Vercel server env vars. Never prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY must be present in production, but is intentionally not listed as an assignable example here.
